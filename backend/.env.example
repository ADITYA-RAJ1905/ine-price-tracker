# Port for the Express server
PORT=5000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# Secret key for triggering external cron jobs (e.g. from cron-job.org)
# Set a random secret string here and supply it as header: x-cron-secret: your_secret
CRON_SECRET=ine_cron_secret_2026

# Target Mock Store URL
MOCK_STORE_URL=https://demo.inelabteamdev.com

